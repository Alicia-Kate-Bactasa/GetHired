{
  "openapi": "3.1.0",
  "info": {
    "title": "GetHired B1 browser API",
    "version": "1.0.0",
    "description": "Implemented authentication surface after extraction to Express. Browser requests use the Next.js same-origin proxy. The backend additionally requires a server-only X-GetHired-Gateway credential except on GET /api/health/live. Cookies remain HttpOnly/Secure/SameSite=Lax/Path=/ with no Domain. Signup, recovery, business endpoints and readiness are future phases. All controlled errors use the JSON envelope; HEAD has no response body. Unsupported methods return 405 with Allow; unknown paths return 404. AUTH_ENABLED=false returns safe 503 for auth routes."
  },
  "servers": [
    {
      "url": "/api",
      "description": "Same-origin frontend proxy"
    }
  ],
  "paths": {
    "/auth/csrf": {
      "get": {
        "operationId": "csrf",
        "description": "Issues or reuses the browser binding and returns its CSRF token. Cross-site bootstrap is rejected; refresh the token after login binding rotation.",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Csrf"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ApiError"
          }
        },
        "security": []
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "description": "Validates Supabase credentials and active application account. Issues access/refresh/binding cookies. Returns no provider credentials.",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ApiError"
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Exact browser-facing APP_ORIGIN."
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Token from csrf bootstrap for the current browser binding."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "security": [
          {
            "browserBinding": []
          }
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "me",
        "description": "Checks JWT plus live provider/application account and session state. Does not extend idle activity.",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ApiError"
          }
        },
        "security": [
          {
            "accessCookie": [],
            "browserBinding": []
          }
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "description": "Rotates provider credentials within the original active session deadline. Access JWT may be expired; refresh and signed browser binding remain required.",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refreshed"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ApiError"
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Exact browser-facing APP_ORIGIN."
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Token from csrf bootstrap for the current browser binding."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Empty"
              }
            }
          }
        },
        "security": [
          {
            "refreshCookie": [],
            "browserBinding": []
          }
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "description": "Revokes the bound current session then clears all three cookies. Anonymous/stale access credentials are accepted with valid CSRF binding; it does not log out other devices.",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoggedOut"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ApiError"
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Exact browser-facing APP_ORIGIN."
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Token from csrf bootstrap for the current browser binding."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Empty"
              }
            }
          }
        },
        "security": [
          {
            "browserBinding": []
          }
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live",
        "description": "Process liveness only; this does not check database readiness. May be called directly on the backend without a gateway credential.",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Live"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ApiError"
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "admin"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "student": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StudentProfile"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "role",
          "displayName",
          "email",
          "student"
        ]
      },
      "StudentProfile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "studentNumber": {
            "type": "string",
            "pattern": "^[0-9]{8}$"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "course": {
            "type": "string"
          },
          "yearLevel": {
            "type": "string"
          }
        },
        "required": [
          "studentNumber",
          "firstName",
          "lastName",
          "course",
          "yearLevel"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "rememberMe": {
            "type": "boolean"
          }
        },
        "required": [
          "expiresAt",
          "rememberMe"
        ]
      },
      "LoginInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "type": "string",
            "maxLength": 254,
            "description": "Eight-digit student number or email; trimmed and normalized server-side."
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "writeOnly": true
          },
          "rememberMe": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "identifier",
          "password"
        ]
      },
      "Empty": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "CurrentUser": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "user": {
                "$ref": "#/components/schemas/User"
              },
              "session": {
                "$ref": "#/components/schemas/Session"
              }
            },
            "required": [
              "user",
              "session"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "data",
          "requestId"
        ]
      },
      "Csrf": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "csrfToken": {
                "type": "string"
              }
            },
            "required": [
              "csrfToken"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "data",
          "requestId"
        ]
      },
      "Refreshed": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "session": {
                "$ref": "#/components/schemas/Session"
              }
            },
            "required": [
              "session"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "data",
          "requestId"
        ]
      },
      "LoggedOut": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "loggedOut": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "loggedOut"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "data",
          "requestId"
        ]
      },
      "Live": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "data",
          "requestId"
        ]
      },
      "Failure": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fieldErrors": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "error",
          "requestId"
        ]
      }
    },
    "securitySchemes": {
      "accessCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-gethired-access",
        "description": "Production access JWT cookie; development uses gethired-dev-access."
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-gethired-refresh",
        "description": "Production refresh credential cookie; development uses gethired-dev-refresh."
      },
      "browserBinding": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-gethired-browser",
        "description": "Signed browser/session binding; development uses gethired-dev-browser."
      }
    },
    "responses": {
      "ApiError": {
        "description": "Safe application error; stable phase 1 code. Includes Allow for 405 or Retry-After for 429 as applicable.",
        "headers": {
          "X-Request-ID": {
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "private, no-store"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Failure"
            }
          }
        }
      }
    }
  }
}
