# Copy to .env.local for development. Production requires the deployed HTTPS origin.
APP_ORIGIN=http://localhost:3000

# Ordinary JSON bodies: at most 64 KiB, counted from actual bytes read.
API_MAX_BODY_BYTES=65536

# JSON request logs go to stdout; the deployment platform collects them.
API_LOG_DESTINATION=stdout

# Phase 3: leave disabled until the development Supabase project is configured.
# Disabled authentication endpoints fail closed with 503; there is no mock fallback.
AUTH_ENABLED=false
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# Match the asymmetric signing key configured in Supabase. Access JWT lifetime: 900s.
SUPABASE_JWT_ALGORITHMS=ES256
# Restricted login role with membership in gethired_runtime; direct or session pooler URL.
# No URL query parameters. TLS certificate validation is always enabled.
DATABASE_URL=postgresql://APP-LOGIN:PASSWORD@DATABASE-HOST:5432/postgres
# Generate once using: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Share across instances; do not use the example value or rotate on every deploy.
AUTH_COOKIE_SECRET=REPLACE-WITH-64-RANDOM-HEX-CHARACTERS
# Required in production: a single-IP header overwritten by your trusted ingress.
# Leave empty in development to use a conservative shared development rate bucket.
AUTH_TRUSTED_IP_HEADER=
